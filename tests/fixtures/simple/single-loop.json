{
  "process": {
    "id": "process-loop-001",
    "name": "Single Loop Process",
    "version": 1,
    "executable": true
  },
  "nodes": [
    {
      "id": "start-1",
      "type": "startEvent",
      "position": { "x": 100, "y": 100 },
      "data": {
        "label": "Start",
        "width": 50,
        "height": 50
      }
    },
    {
      "id": "task-1",
      "type": "userTask",
      "position": { "x": 300, "y": 100 },
      "data": {
        "label": "Review",
        "width": 120,
        "height": 80,
        "assignee": "${reviewer}"
      }
    },
    {
      "id": "gateway-1",
      "type": "exclusiveGateway",
      "position": { "x": 500, "y": 100 },
      "data": {
        "label": "Needs Revision?",
        "width": 60,
        "height": 60
      }
    },
    {
      "id": "end-1",
      "type": "endEvent",
      "position": { "x": 700, "y": 100 },
      "data": {
        "label": "End",
        "width": 50,
        "height": 50
      }
    }
  ],
  "edges": [
    {
      "id": "flow-1",
      "source": "start-1",
      "target": "task-1",
      "data": {},
      "type": "default"
    },
    {
      "id": "flow-2",
      "source": "task-1",
      "target": "gateway-1",
      "data": {},
      "type": "default"
    },
    {
      "id": "flow-approve",
      "source": "gateway-1",
      "target": "end-1",
      "data": {
        "label": "Approved",
        "condition": "${approved == true}"
      },
      "type": "default"
    },
    {
      "id": "loop-back",
      "source": "gateway-1",
      "target": "task-1",
      "data": {
        "label": "Revision Needed",
        "condition": "${approved == false}"
      },
      "type": "default"
    }
  ]
}
